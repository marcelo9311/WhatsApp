{
  "name": "whatsapp-claude",
  "version": "1.0.0",
  "description": "Bot de WhatsApp (Cloud API) que guarda los mensajes del día, analiza reportes con Claude y envía un resumen diario.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
