# --- Claude ---
ANTHROPIC_API_KEY=sk-ant-...

# --- WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > Configuración de la API) ---
WHATSAPP_TOKEN=EAAG...            # Token de acceso permanente (usuario del sistema)
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_APP_SECRET=abc123...      # Configuración de la app > Básica > Clave secreta
WHATSAPP_VERIFY_TOKEN=elige-una-palabra-secreta   # La misma que pongas al configurar el webhook

# --- Bot ---
# Tu número personal, en formato internacional sin "+" ni espacios (ej. Colombia: 573001234567).
# Los mensajes que vengan de este número se tratan como preguntas tuyas al bot.
OWNER_PHONE=573001234567
# Hora del resumen automático (24 h) y zona horaria
DAILY_SUMMARY_TIME=19:00
TIMEZONE=America/Bogota
# Respuesta automática a quien manda un reporte (deja vacío para no responder)
ACK_MESSAGE=Recibido ✅ Gracias por tu reporte.
# Plantilla aprobada en Meta que se usa si llevas más de 24 h sin escribirle al bot (opcional, ver README)
SUMMARY_TEMPLATE_NAME=
SUMMARY_TEMPLATE_LANG=es

PORT=3000
DB_PATH=data/bot.db
